# ─────────────────────────────────────────────
# Krishi Setu — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000

# MongoDB connection string
# For local MongoDB:  mongodb://localhost:27017/krishi_setu
# For MongoDB Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/krishi_setu?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/krishi_setu

# CORS — allowed frontend origin(s). Comma-separated for multiple.
# Supports Next.js (3000/3001) and Vite (5173) by default.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# data.gov.in OGD API key (register free at https://data.gov.in/user/register)
# Status: NOT YET OBTAINED — integration pending key registration
OGD_API_KEY=REPLACE_WITH_YOUR_KEY

# Request timeouts (milliseconds)
EXTERNAL_API_TIMEOUT_MS=10000

# Data freshness — price data older than this many hours is marked stale
PRICE_STALE_AFTER_HOURS=72

# Weather data freshness (hours)
WEATHER_STALE_AFTER_HOURS=6

# JWT Authentication
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET
JWT_EXPIRES_IN=7d

# Seed data flag — set to "true" to allow the seed script to run
ALLOW_SEED=false
